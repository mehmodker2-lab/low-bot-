# ── إعدادات البوت (انسخها إلى Render → Environment أو إلى ملف .env محلياً) ──

# توكن البوت من @BotFather (إلزامي في الإنتاج)
BOT_TOKEN=

# معرفك الرقمي في تيليجرام (الأونر)
ADMIN_ID=

# رابط قاعدة البيانات الدائمة (Supabase Pooler — منفذ 6543)
# مثال: postgresql://postgres.xxxx:pass@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# اسم النسخة (عند تشغيل أكثر من نسخة)
INSTANCE_ID=main

# 1 = تشغيل البوت | 0 = خادم ويب فقط
RUN_BOT=1

# بديل SQLite على قرص Render الدائم (اتركه فارغاً إذا استعملت DATABASE_URL)
# DATA_DIR=/var/data

# خيارات متقدمة (اختيارية)
# DB_POOL_MAX=10
# DB_CONNECT_RETRIES=6
# DB_ALLOW_SQLITE_FALLBACK=0
# MULTI_INSTANCE=0
# POLLER_LOCK_STALE_SECONDS=90
# RADAR_GRACE_SECONDS=90
# RADAR_EVERY_N_CYCLES=2
# SUPPRESSION_RETENTION_DAYS=7

# إشعارات الأخطاء الفنية في الخاص: 0 = مطفأة (الافتراضي، مناسب للبيع للزبائن)
# حتى عند تفعيلها لا تُرسل أخطاء 409 أو انقطاع الشبكة، وتُرسل رسالة عربية قصيرة فقط.
# SEND_ERROR_REPORTS=0
